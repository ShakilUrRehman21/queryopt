# QueryOpt Lab environment configuration — copy to .env and adjust.
# (These are the variable names the code actually reads.)

QUERYOPT_ENV=development          # development | testing | production
DATA_DIR=./data                   # catalog, pages, statistics, feedback store, learned models
RESULTS_DIR=./experiments/results
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                   # text | json
PUBLIC_DEMO_MODE=false

# Resource limits
MAX_QUERY_TIME_SECONDS=30.0
MAX_ROWS_RETURNED=100000
MAX_ROWS_SCANNED=10000000
MAX_MEMORY_MB=512

# ── AI Lab ───────────────────────────────────────────────────────────────
# auto = anthropic if ANTHROPIC_API_KEY is set, else openai if QUERYOPT_LLM_BASE_URL is set, else offline
QUERYOPT_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
# QUERYOPT_LLM_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible server, e.g. local Ollama:
# QUERYOPT_LLM_BASE_URL=http://localhost:11434/v1
# QUERYOPT_LLM_MODEL=llama3.1
# OPENAI_API_KEY=
QUERYOPT_LLM_CACHE=true           # replay identical prompts from DATA_DIR/llm_cache.json (reproducible RQ5 runs)
